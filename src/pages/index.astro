    waves: '<svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M4.5 8.1q3.75-2.7 7.5 0t7.5 0"/><path d="M3.8 12q4.1-2.8 8.2 0t8.2 0"/><path d="M4.5 15.9q3.75-2.7 7.5 0t7.5 0"/></svg>',
    harr: '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M8 8l-4 4 4 4M16 8l4 4-4 4"/></svg>',
    vsel: '<svg width="10" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m8 9 4-4 4 4M8 15l4 4 4-4"/></svg>',
    slider: '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 8h10M18 8h2M4 16h2M10 16h10"/><circle cx="16" cy="8" r="2.2"/><circle cx="7" cy="16" r="2.2"/></svg>',
    shrink: '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 4l-6 6M14 4v6h6M4 20l6-6M10 20v-6H4"/></svg>',
  };

  const statusBar = () =>
    `<div class="flow-status-bar"><span>5:03</span><span class="sb-right">${G.wifi}<span class="sb-batt"></span></span></div>`;
  /* The floating tab dock — a 3-tab glass pill plus the separate "+" FAB
     and Flow wave button, exactly as ContentView lays it out. */
  const dock = (active) => {
    const tab = (id, label, ico) =>
      `<span class="vsx-tab ${active === id ? 'active' : ''}">${ico}<i>${label}</i></span>`;
    return `<div class="vsx-dock">
      <span class="vsx-pill">${tab('home', 'Home', G.home)}${tab('cal', 'Calendar', G.cal)}${tab('courses', 'Courses', G.book)}</span>
      <span class="vsx-fab">${G.plus}</span>
      <span class="vsx-flow">${G.waves}</span>
    </div>`;
  };

  /* Shared wave-timeline pieces (FlowTimelineHero / CalRehaulWaveDay port):
     two-line time column, status dots, glass cards, striped job cards,
     dashed gap "Plan" chips, and the live NOW card. */
  const vsxWave = `<svg class="vsx-wave" viewBox="0 0 20 400" preserveAspectRatio="none" fill="none" stroke="rgba(158,159,234,0.8)" stroke-width="2.6" stroke-linecap="round"><path d="M10 0 Q3 30 10 60 Q17 90 10 120 Q3 150 10 180 Q17 210 10 240 Q3 270 10 300 Q17 330 10 360 Q6 385 10 400"/></svg>`;
  const vsxTime = (a, b) => `<span class="vsx-time">${a}<small>${b}</small></span>`;
  const vsxDot = (kind, color) => {
    if (kind === 'done') return `<span class="vsx-dot done" style="background:${color}">${G.check}</span>`;
    if (kind === 'live') return `<span class="vsx-dot live"><i></i></span>`;
    return `<span class="vsx-dot future"></span>`;
  };
  const vsxJob = (t1, t2, name, sub, loc) =>
    `<div class="vsx-row">${vsxTime(t1, t2)}${vsxDot('done', 'var(--amber)')}
      <div class="vsx-card job dim"><span class="bar"></span><b>${name}</b><span class="sub">${sub}</span>${loc ? `<span class="loc">${G.pin} ${loc}</span>` : ''}<span class="done-tag">done</span></div>
    </div>`;
  const vsxPlan = (label) =>
    `<div class="vsx-plan"><span></span><span class="pluscoin">${G.plus}</span><span class="chip"><b>Plan</b>${label}</span></div>`;

  function vsHome() {
    return `<div class="vscreen"><div class="vs">
      ${statusBar()}
      <div class="vs-head">
        <div><div class="vs-eyebrow">Friday · Jul 3</div><div class="vs-title">Good afternoon</div></div>
        <div class="vs-head-btns"><span class="vs-hb">${G.spark}</span><span class="vs-hb">${G.user}</span><span class="vs-hb">${G.gear}</span></div>
      </div>
      <div class="vsx-hero">
        <div class="vsx-hero-top"><span class="vsx-kicker">My Day</span><span class="vsx-streak">${G.flame} <b>5</b> <i>day</i></span></div>
        <div class="vsx-h">9 stops on your day.</div>
        <div class="vsx-tl">
          ${vsxWave}
          ${vsxJob('12:30a', '3:00a', 'Cafe', '12:30a – 3:00a · 2h 30m', 'Opening')}
          ${vsxPlan('6h free')}
          ${vsxJob('9:00a', '1:00p', 'Starbucks', '9:00a – 1:00p · 4h', 'Downtown')}
          <div class="vsx-row">${vsxTime('9:00a', '9:50a')}${vsxDot('done', 'var(--mint)')}
            <div class="vsx-card dim"><span class="bar" style="background:var(--mint)"></span><b>Physics 4B</b><span class="sub">9:00a – 9:50a · 50 min</span><span class="done-tag">done</span></div>
          </div>
          ${vsxPlan('3h 10m free')}
          <div class="vsx-row">${vsxTime('1:00p', '2:15p')}${vsxDot('live')}
            <div class="vsx-card vsx-now">
              <div class="vsx-now-top"><span class="now-l"><i></i>NOW</span><span class="now-r">1h 9m left</span></div>
              <b class="title">Calculus II</b>
              <span class="dur">1h 15m</span>
              <span class="vsx-prog"><i></i></span>
              <div class="vsx-now-foot"><span>1:00p</span><span>ends 2:15p</span></div>
            </div>
          </div>
          <div class="vsx-more"><i></i><span>+ 5 more</span></div>
