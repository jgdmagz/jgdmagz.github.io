  // A focus-mode screen: minutes:seconds with a smaller centiseconds tail.
  function flowVScreen(mode, title, icon, time, secs, status) {
    return `<div class="vscreen flow-screen" data-flow="${mode}" data-seconds="${secs}">
      <canvas class="flow-dots"></canvas>
      <div class="flow-ui">
        ${statusBar()}
        <div class="flow-top"><span class="ft-ico">${G.chevL}</span><span class="ft-title">${title}</span><span class="ft-ico">${icon}</span></div>
        <div class="flow-center"><div class="flow-blob"></div><div class="flow-time" data-seconds="${secs}"><span class="mmss">${time}</span><span class="centi">.00</span></div><div class="flow-status"><i></i> ${status}</div></div>
        <div class="flow-controls"><span class="flow-btn">${G.flag}</span><span class="flow-btn primary">${G.pause}</span><span class="flow-btn">${G.stop}</span></div>
      </div>
    </div>`;
  }

  const SCREENS = {
    home: vsHome,
    calendar: vsCalendar,
    courses: vsCourses,
    endless: () => flowVScreen('endless', 'Endless Flow', G.inf, '24:13', 1453, 'FLOWING'),
    regular: () => flowVScreen('regular', 'Regular Flow', G.inf, '18:42', 1122, 'FOCUS'),
  };

  /* build every [data-vec] slot */
  document.querySelectorAll('[data-vec]').forEach((slot) => {
    const list = slot.dataset.vec.split(',').map((s) => s.trim()).filter((s) => SCREENS[s]);
    slot.innerHTML = list.map((name) => SCREENS[name]()).join('');
    const first = slot.querySelector('.vscreen');
    if (first) first.classList.add('on');
  });

  /* polished inner chamfer layer for every phone */
  document.querySelectorAll('.phone').forEach((p) => {
    if (!p.querySelector('.phone-chamfer')) {
      p.insertAdjacentHTML('afterbegin', '<div class="phone-chamfer"></div>');
    }
  });

  /* ── live dot grid (ported from the app's DotGridView) ── */
  function makeFlowDots(canvas) {
    const ctx = canvas.getContext('2d');
    const screen = canvas.closest('.flow-screen');
    let w = 0, h = 0, raf = 0, startT = 0, rz;
    const channels = () => getComputedStyle(screen).getPropertyValue('--fd').trim() || '89,91,205';

    function build() {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = rect.width; h = rect.height;
      if (!w || !h) return;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    function frame(time) {
      if (!w) { build(); if (!w) return; }
      const rgb = channels();
      const spacing = Math.max(11, w * 0.05);
      const dot = spacing * 0.2;
      const cx = w / 2, cy = h * 0.45;
      const maxDist = Math.hypot(w, h) * 0.5;
      ctx.clearRect(0, 0, w, h);
      for (let y = 0; y < h + spacing; y += spacing) {
        for (let x = 0; x < w + spacing; x += spacing) {
          const dist = Math.hypot(x - cx, y - cy);
          const wave = Math.sin(dist / (maxDist * 0.16) - time * 1.8);
          const sizeMul = 1 + wave * 0.35;
          const fade = Math.max(0.04, 0.2 - (dist / maxDist) * 0.16) + wave * 0.04;
          const r = (dot * sizeMul) / 2;
          ctx.beginPath();
          ctx.arc(x, y, Math.max(0.3, r), 0, 6.2832);
          ctx.fillStyle = `rgba(${rgb},${Math.max(0, fade)})`;
          ctx.fill();
        }
      }
    }
    function loop(t) { if (!startT) startT = t; frame((t - startT) / 1000); raf = requestAnimationFrame(loop); }
    const api = {
      play() { if (reduce) { build(); frame(0); return; } if (!raf) raf = requestAnimationFrame(loop); },
      pause() { cancelAnimationFrame(raf); raf = 0; },
      rebuild() { build(); if (reduce) frame(0); },
    };
    build();
    window.addEventListener('resize', () => { clearTimeout(rz); rz = setTimeout(api.rebuild, 150); });
    return api;
  }
  const flowDots = [...document.querySelectorAll('.flow-dots')].map((c) => makeFlowDots(c));

  /* ── ticking timers (phone screens + the flow band hero clock) ── */
  const tickers = [...document.querySelectorAll('.flow-time[data-seconds], .fb-time[data-seconds]')].map((el) => ({
    base: parseInt(el.dataset.seconds, 10),
    mmss: el.querySelector('.mmss'),
    centi: el.querySelector('.centi'),
  }));
  const fmt = (sec) => `${String(Math.floor(sec / 60)).padStart(2, '0')}:${String(sec % 60).padStart(2, '0')}`;
  if (!reduce && tickers.length) {
    const t0 = performance.now();
    setInterval(() => {
      const el = (performance.now() - t0) / 1000;
      tickers.forEach((f) => { if (f.mmss) f.mmss.textContent = fmt(f.base + Math.floor(el)); });
    }, 1000);
    setInterval(() => {
      const ms = Math.floor((performance.now() % 1000) / 10);
      const tail = '.' + String(ms).padStart(2, '0');
      tickers.forEach((f) => { if (f.centi) f.centi.textContent = tail; });
    }, 90);
  }

  /* ─────────────────────────────────────────────
     PIXEL OCEAN — the login's living surf, ported.
     Domain-warped FBM value noise on a soft square
     grid; wave height maps onto a brand colour ramp
     with sparkle riding the crests.
     ───────────────────────────────────────────── */
  function hash2(x, y) {
    const h = Math.sin(x * 127.1 + y * 311.7) * 43758.5453123;
    return h - Math.floor(h);
  }
  const smooth = (t) => t * t * (3 - 2 * t);
  function valueNoise(x, y) {
    const xi = Math.floor(x), yi = Math.floor(y);
    const xf = x - xi, yf = y - yi;
    const a = hash2(xi, yi), b = hash2(xi + 1, yi), c = hash2(xi, yi + 1), d = hash2(xi + 1, yi + 1);
    const u = smooth(xf), v = smooth(yf);
    return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
  }
  function fbm(x, y) {
    let value = 0, amp = 0.5, fx = x, fy = y;
    for (let i = 0; i < 4; i++) {
      value += amp * valueNoise(fx, fy);
      fx *= 2.02; fy *= 1.98; amp *= 0.5;
    }
    return value;
  }
  const RAMPS = {
    light: {
      bg: 'rgb(226,228,240)',
      stops: [
        [0.0, [244, 244, 250]],
        [0.3, [230, 231, 246]],
        [0.52, [199, 201, 242]],
        [0.7, [158, 159, 234]],
        [0.86, [107, 109, 214]],
        [1.0, [63, 63, 180]],
      ],
    },
    dark: {
      bg: 'rgb(23,24,47)',
      stops: [
        [0.0, [23, 24, 47]],
        [0.34, [35, 36, 74]],
        [0.56, [63, 63, 180]],
        [0.74, [107, 109, 214]],
        [0.9, [158, 159, 234]],
        [1.0, [222, 222, 250]],
      ],
    },
  };
  function makeOcean(canvas, ramp) {
    const ctx = canvas.getContext('2d');
    const CELL = 11, GAP = 1.5;
    const { stops, bg } = ramp;
    const rampColor = (t) => {
      const v = Math.min(1, Math.max(0, t));
      for (let i = 1; i < stops.length; i++) {
        if (v <= stops[i][0]) {
          const [t0, c0] = stops[i - 1];
          const [t1, c1] = stops[i];
          const k = (v - t0) / (t1 - t0);
          return [c0[0] + (c1[0] - c0[0]) * k, c0[1] + (c1[1] - c0[1]) * k, c0[2] + (c1[2] - c0[2]) * k];
        }
      }
      return stops[stops.length - 1][1];
    };
    const draw = (t) => {
      const wrap = canvas.parentElement;
      if (!wrap) return;
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      const W = wrap.clientWidth, H = wrap.clientHeight;
      if (!W || !H) return;
      if (canvas.width !== Math.round(W * dpr) || canvas.height !== Math.round(H * dpr)) {
        canvas.width = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
      }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.fillStyle = bg;
      ctx.fillRect(0, 0, W, H);
      const cols = Math.ceil(W / CELL), rows = Math.ceil(H / CELL);
      for (let gy = 0; gy < rows; gy++) {
        for (let gx = 0; gx < cols; gx++) {
          const nx = gx * 0.09, ny = gy * 0.11;
          const bend =
            0.5 * Math.sin(nx * 1.35 + t * 0.85) +
            0.28 * Math.sin(nx * 2.5 - t * 0.55) +
            0.9 * (fbm(nx * 0.55 + t * 0.06, ny * 0.5 - t * 0.04) - 0.5);
          let hgt = 0.5 + 0.5 * Math.sin((ny + bend) * 3.4 - t * 0.7);
          hgt = Math.pow(Math.min(1, Math.max(0, hgt)), 2.1);
          if (hgt > 0.62) {
            const sparkle = valueNoise(gx * 3.1 + t * 2.2, gy * 3.3 - t * 1.7);
            hgt = Math.min(1, hgt + (sparkle > 0.86 ? 0.5 : 0) * (hgt - 0.62));
          }
          const [r, g, b] = rampColor(hgt);
          ctx.fillStyle = `rgb(${r | 0},${g | 0},${b | 0})`;
          ctx.beginPath();
          ctx.roundRect(gx * CELL + GAP / 2, gy * CELL + GAP / 2, CELL - GAP, CELL - GAP, 2);
          ctx.fill();
        }
      }
    };
    if (reduce) {
      draw(4.2);
      return { setActive() {} };
    }
    let raf = 0, last = 0, active = false;
    const tick = (ms) => {
      raf = requestAnimationFrame(tick);
      if (document.hidden || ms - last < 40) return; // ~25fps — plenty for surf
      last = ms;
      draw(ms / 1000);
    };
    return {
      setActive(on) {
        if (on && !active) { active = true; raf = requestAnimationFrame(tick); }
        else if (!on && active) { active = false; cancelAnimationFrame(raf); }
      },
    };
  }
  /* run each ocean only while it's on screen */
  document.querySelectorAll('canvas[data-ocean]').forEach((cv) => {
    const ocean = makeOcean(cv, RAMPS[cv.dataset.ocean] || RAMPS.light);
    if (reduce) return;
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => ocean.setActive(e.isIntersecting)),
      { rootMargin: '80px' }
    );
    io.observe(cv);
  });

  /* ── hero entrance — only arm once the timeline is confirmed advancing ── */
  if (!reduce) {
    requestAnimationFrame((t1) =>
      requestAnimationFrame((t2) => {
        if (t2 > t1) document.body.classList.add('anims-ready');
      })
    );
  }

  /* ── hero stage tilt — the phone cluster leans toward the pointer ── */
  const tilt = document.querySelector('[data-tilt]');
  if (tilt && !reduce && matchMedia('(pointer: fine)').matches) {
    let tx = 0, ty = 0, cx = 0, cy = 0, rafT = 0;
    const hero = tilt.closest('.hero');
    const settle = () => {
      cx += (tx - cx) * 0.08;
      cy += (ty - cy) * 0.08;
      tilt.style.transform = `rotateY(${cx}deg) rotateX(${-cy}deg)`;
      if (Math.abs(tx - cx) > 0.01 || Math.abs(ty - cy) > 0.01) rafT = requestAnimationFrame(settle);
      else rafT = 0;
    };
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      tx = ((e.clientX - r.left) / r.width - 0.5) * 7;
      ty = ((e.clientY - r.top) / r.height - 0.5) * 5;
      if (!rafT) rafT = requestAnimationFrame(settle);
    });
    hero.addEventListener('pointerleave', () => {
      tx = 0; ty = 0;
      if (!rafT) rafT = requestAnimationFrame(settle);
    });
  }

  /* ── magnetic CTAs — nudge toward the pointer, spring back ── */
  if (!reduce && matchMedia('(pointer: fine)').matches) {
    document.querySelectorAll('.magnetic').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        const dx = e.clientX - (r.left + r.width / 2);
        const dy = e.clientY - (r.top + r.height / 2);
        el.style.transform = `translate(${dx * 0.18}px, ${dy * 0.26}px)`;
      });
      el.addEventListener('pointerleave', () => {
        el.style.transform = '';
      });
    });
  }

  /* ── rails — the wavy connectors draw themselves as you scroll ── */
  const railPaths = [...document.querySelectorAll('.rail-line path')].map((p) => {
    const L = p.getTotalLength();
    p.style.strokeDasharray = String(L);
    p.style.strokeDashoffset = String(reduce ? 0 : L);
    return { p, L };
  });
  if (!reduce && railPaths.length) {
    let railTick = false;
    const drawRails = () => {
      const vh = innerHeight;
      railPaths.forEach(({ p, L }) => {
        const r = p.closest('.rail-line').getBoundingClientRect();
        if (r.bottom < 0 || r.top > vh) return;
        const prog = Math.min(1, Math.max(0, (vh * 0.82 - r.top) / (r.height + vh * 0.24)));
        p.style.strokeDashoffset = String(L * (1 - prog));
      });
      railTick = false;
    };
    addEventListener('scroll', () => {
      if (!railTick) { railTick = true; requestAnimationFrame(drawRails); }
    }, { passive: true });
    drawRails();
  }

  /* ── chapter phones — a gentle scroll parallax drift ── */
  const chapterPhones = [...document.querySelectorAll('[data-chapter-phone]')];
  if (!reduce && chapterPhones.length) {
    let phTick = false;
    const drift = () => {
      const vh = innerHeight;
      chapterPhones.forEach((ph) => {
        const r = ph.getBoundingClientRect();
        if (r.bottom < -80 || r.top > vh + 80) return;
        const c = (r.top + r.height / 2 - vh / 2) / vh; // -0.5..0.5
        ph.style.transform = `translateY(${c * -26}px) rotate(${c * -2.2}deg)`;
      });
      phTick = false;
    };
    addEventListener('scroll', () => {
      if (!phTick) { phTick = true; requestAnimationFrame(drift); }
    }, { passive: true });
    drift();
  }

  /* ── count-ups (GPA tile) ── */
  const counters = document.querySelectorAll('[data-count]');
  if (counters.length) {
    const runCount = (el) => {
      const target = parseFloat(el.dataset.count);
      const dec = parseInt(el.dataset.decimals || '0', 10);
      if (reduce) { el.textContent = target.toFixed(dec); return; }
      const t0 = performance.now(), DUR = 1300;
      const step = (now) => {
        const p = Math.min(1, (now - t0) / DUR);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = (target * eased).toFixed(dec);
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { runCount(e.target); io.unobserve(e.target); }
      });
    }, { threshold: 0.5 });
    counters.forEach((el) => io.observe(el));
  }

  /* start canvases + pause everything when the tab hides */
  flowDots.forEach((f) => f.play());
  document.addEventListener('visibilitychange', () => {
    const act = document.hidden ? 'pause' : 'play';
    flowDots.forEach((f) => f[act]());
  });

  /* FAQ accordion */
  document.querySelectorAll('.faq-q').forEach((q) => {
    q.addEventListener('click', () => {
      const item = q.closest('.faq-item');
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach((o) => o.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    });
  });

  /* ── theme comparison slider — drag to wipe Living Flow ↔ Sketch ── */
  function themeHome() {
    return `<div class="th-screen">
      <div class="th-status"><span>5:03</span><span class="th-status-r">${G.wifi}<span class="th-batt"></span></span></div>
      <div class="th-head">
        <div><div class="th-eyebrow">Sunday · May 31</div><div class="th-title">Good evening</div></div>
        <div class="th-hbtns"><span class="th-hb">${G.spark}</span><span class="th-hb">${G.user}</span><span class="th-hb">${G.gear}</span></div>
      </div>
      <div class="th-card">
        <div class="th-card-top"><span class="th-kicker">My Day</span><span class="th-streak">${G.flame} 5 day</span></div>
        <div class="th-card-h">5 stops on your day.</div>
        <div class="th-timeline">
          <svg class="th-wave" viewBox="0 0 20 200" preserveAspectRatio="none" fill="none" stroke="var(--tc-accent)" stroke-opacity="0.5" stroke-width="3" stroke-linecap="round"><path d="M10 0 Q2 28 10 56 Q18 88 10 120 Q3 154 10 180 Q14 194 10 200"/></svg>
          <div class="th-stop"><span class="t">1:00p</span><span class="ring" style="--c:var(--tc-coral)"></span><b>Calculus II</b><span class="dur">1h 15m</span></div>
          <div class="th-stop"><span class="t">6:00p</span><span class="ring" style="--c:var(--tc-accent)"></span><b>CS 101</b><span class="dur">1h 15m</span></div>
          <div class="th-stop"><span class="t">8:00p</span><span class="ring" style="--c:var(--tc-mint)"></span><b>Reading 2</b><span class="dur">CS 101</span></div>
        </div>
        <div class="th-cta">${G.spark} Explore your day</div>
      </div>
      <div class="th-tabbar">
        <div class="th-tab active"><span class="th-tab-ico">${G.home}</span>Home</div>
        <div class="th-tab"><span class="th-tab-ico">${G.cal}</span>Calendar</div>
        <div class="th-tab"><span class="th-tab-ico">${G.book}</span>Courses</div>
        <div class="th-wind">${G.wind}</div>
      </div>
    </div>`;
  }

  const tc = document.querySelector('[data-theme-compare]');
  if (tc) {
    tc.querySelectorAll('[data-theme-home]').forEach((host) =>
      host.insertAdjacentHTML('beforeend', themeHome())
    );

    /* Sketch theme: draw hand-drawn "rough ink" borders (seeded, like the app's
       RoughBorder) as inline SVG — no filters, so it's crisp everywhere. */
    const sketchPane = tc.querySelector('.tc-sketch');
    const xorshift = (seed) => {
      let s = seed >>> 0 || 1;
      return () => { s ^= s << 13; s ^= s >>> 17; s ^= s << 5; return (s >>> 0) / 4294967296; };
    };
    function buildRoughBorders() {
      if (!sketchPane) return;
      const els = sketchPane.querySelectorAll('.th-card, .th-hb, .th-tabbar, .th-cta, .th-streak, .th-wind');
      els.forEach((el, i) => {
        el.querySelectorAll(':scope > .th-stroke').forEach((n) => n.remove());
        const w = el.clientWidth, h = el.clientHeight;
        if (!w || !h) return;
        const cr = parseFloat(getComputedStyle(el).borderTopLeftRadius) || 12;
        const r = Math.min(cr, w / 2, h / 2);
        const rnd = xorshift(9173 + i * 131);
        const amp = Math.min(2.2, Math.max(0.9, h * 0.016));
        const m = 1.6, x0 = m, y0 = m, x1 = w - m, y1 = h - m;
        const pass = (a) => {
          const j = () => ((rnd() * 2 - 1) * a).toFixed(1);
          const P = (x, y) => `${(x).toFixed(1)},${(y).toFixed(1)}`;
          return `M${P(x0 + r, y0)} `
            + `L${x1 - r + +j()},${y0 + +j()} Q${x1},${y0} ${x1},${y0 + r} `
            + `L${x1 + +j()},${y1 - r + +j()} Q${x1},${y1} ${x1 - r},${y1} `
            + `L${x0 + r + +j()},${y1 + +j()} Q${x0},${y1} ${x0},${y1 - r} `
            + `L${x0 + +j()},${y0 + r + +j()} Q${x0},${y0} ${x0 + r},${y0} Z`;
        };
        const svg =
          `<svg class="th-stroke" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none" aria-hidden="true">` +
          `<path d="${pass(amp)}"/><path d="${pass(amp * 0.65)}" opacity="0.5"/></svg>`;
        el.insertAdjacentHTML('afterbegin', svg);
      });
    }
    buildRoughBorders();
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(buildRoughBorders);
    let rbTimer;
    window.addEventListener('resize', () => { clearTimeout(rbTimer); rbTimer = setTimeout(buildRoughBorders, 160); });

    const screen = tc.querySelector('.phone-screen');
    const handle = tc.querySelector('[data-tc-handle]');
    const setSplit = (pct) => {
      pct = Math.max(2, Math.min(98, pct));
      screen.style.setProperty('--split', pct + '%');
      handle.setAttribute('aria-valuenow', Math.round(pct));
    };
    const fromX = (clientX) => {
      const r = screen.getBoundingClientRect();
      setSplit(((clientX - r.left) / r.width) * 100);
    };
    let dragging = false;
    screen.addEventListener('pointerdown', (e) => {
      dragging = true;
      try { screen.setPointerCapture(e.pointerId); } catch (_) {}
      fromX(e.clientX);
      e.preventDefault();
    });
    screen.addEventListener('pointermove', (e) => { if (dragging) fromX(e.clientX); });
    const stop = () => { dragging = false; };
    screen.addEventListener('pointerup', stop);
    screen.addEventListener('pointercancel', stop);
    handle.addEventListener('keydown', (e) => {
      const cur = parseFloat(handle.getAttribute('aria-valuenow')) || 50;
      if (e.key === 'ArrowLeft') { setSplit(cur - 4); e.preventDefault(); }
      else if (e.key === 'ArrowRight') { setSplit(cur + 4); e.preventDefault(); }
    });
    setSplit(50);
  }
</script>

