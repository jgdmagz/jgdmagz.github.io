  }

  function vsCalendar() {
    const day = (l, n, dots, sel) =>
      `<div class="vsx-day${sel ? ' sel' : ''}"><i>${l}</i><b>${n}</b><span>${dots.map((c) => `<u style="background:${c}"></u>`).join('')}</span></div>`;
    return `<div class="vscreen"><div class="vs">
      ${statusBar()}
      <div class="vs-head">
        <div><div class="vs-eyebrow">Today</div><div class="vs-title">Jul 3</div></div>
      </div>
      <div class="vsx-monthbar">
        <span class="vsx-mpill">${G.chevL}<b>July <i>2026</i></b>${G.chevD}${G.chevR}</span>
        <span class="vsx-mtools"><span class="flip"><u></u></span>${G.plus}</span>
      </div>
      <div class="vsx-weekstrip">
        ${day('S', '28', ['var(--amber)', 'var(--coral)'])}
        ${day('M', '29', ['var(--mint)'])}
        ${day('T', '30', ['var(--accent)', 'var(--coral)'])}
        ${day('W', '1', ['var(--mint)', 'var(--coral)', 'var(--accent)'])}
        ${day('T', '2', ['var(--coral)', 'var(--accent)'])}
