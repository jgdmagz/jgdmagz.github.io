---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import '../styles/home.css';

const APPSTORE = 'https://apps.apple.com/us/app/studentflow-academic-planner/id6776430933';

// Small inline line-icons (stroke, currentColor) used across the page.
const ico = {
  check: '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 11 3 3L22 4"/></svg>',
  spark: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c.5 3.5 2 5 5.5 5.5C14 8 12.5 9.5 12 13c-.5-3.5-2-5-5.5-5.5C10 7 11.5 5.5 12 2Z"/><path d="M19 13c.3 1.8 1 2.5 2.8 2.8-1.8.3-2.5 1-2.8 2.7-.3-1.8-1-2.5-2.7-2.8 1.7-.2 2.4-1 2.7-2.7Z"/></svg>',
  gap: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>',
  chart: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>',
  board: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M9 4v17M15 4v17"/></svg>',
  zoom: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3M11 8v6M8 11h6"/></svg>',
  pillico: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="8" rx="4"/><circle cx="8" cy="12" r="1.4" fill="currentColor" stroke="none"/></svg>',
  ticks: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M3 12h18M7 9v6M12 8v8M17 10v4"/></svg>',
  grade: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
  camera: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h3l2-3h6l2 3h3v12H4z"/><circle cx="12" cy="13" r="3.4"/></svg>',
  clock: '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
  inf: '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 7.5a4.5 4.5 0 1 0 0 9c2.5 0 4-2 5.5-4.5C13.5 9.5 15 7.5 17.5 7.5a4.5 4.5 0 1 1 0 9c-2.5 0-4-2-5.5-4.5C10.5 9.5 9 7.5 6.5 7.5Z"/></svg>',
  list: '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13"/><path d="m3 6 1 1 2-2M3 12l1 1 2-2M3 18l1 1 2-2"/></svg>',
  shield: '<svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-3.5 8-10V5l-8-3-8 3v7c0 6.5 8 10 8 10z"/><path d="m9 11.5 2 2 4-4.5"/></svg>',
  flame: '<svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2s4 4 4 8a4 4 0 0 1-8 0c0-1 .5-2 .5-2S6 11 6 14a6 6 0 0 0 12 0c0-5-6-12-6-12z"/></svg>',
  medal: '<svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2s3 3.2 3 6a3 3 0 0 1-6 0c0-.8.35-1.6.35-1.6S8 8.6 8 10.5a4 4 0 0 0 8 0c0-3.5-4-8.5-4-8.5z" transform="translate(0 3.4) scale(0.94)"/></svg>',
  award: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.5 12.9 17 22l-5-3-5 3 1.5-9.1"/></svg>',
  arrow: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>',
  chevD: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>',
  sync: '<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 1-9 9c-2.52 0-4.93-1-6.74-2.74L3 16"/><path d="M3 12a9 9 0 0 1 9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5M3 21v-5h5"/></svg>',
};

const faqs = [
  {
    q: 'Is StudentFlow free?',
    a: 'Yes — StudentFlow is free to download on the App Store. The planner, calendar, focus timer, and GPA tracking are all part of the core app; optional StudentFlow Plus upgrades unlock power features as they ship.',
    open: true,
  },
  {
    q: 'Is there a web version?',
    a: 'Yes — the full StudentFlow web app lives at studentflowapp.com/app. Sign in with the same Apple ID you use on iPhone and your courses, calendar, planner, and Flow timer are right there in the browser.',
  },
  {
    q: "What's Lock-In Mode?",
    a: 'A distraction guard for your Flow sessions. Turn it on before you start and ending early takes a deliberate hold-to-confirm instead of a single tap — so you actually finish what you started.',
  },
  {
    q: 'What is Guided Flow?',
    a: 'A third focus mode alongside Regular and Endless. Instead of a generic timer, you pick the exact assignments you want to work through, and StudentFlow guides you across them.',
  },
  {
    q: 'Can StudentFlow read my work schedule?',
    a: 'Yes. Snap a photo of the posted schedule and StudentFlow reads your shifts and places them on your timeline, right next to classes and deadlines. The recognition runs on-device — the photo never leaves your iPhone.',
  },
  {
    q: "Will it sync with my school's Canvas?",
    a: "Canvas sync is on the way — it'll pull your courses and assignments in automatically, so you never have to enter a deadline by hand.",
  },
  {
    q: 'Is my academic data private?',
    a: "Yes. StudentFlow works without an account and runs offline; your courses and grades live on your device. We don't sell your data — and the web app only uses your Apple ID to sign you in.",
  },
  {
    q: 'What do I need to run it?',
    a: 'An iPhone running iOS 26 or later for the app — and any modern browser for the web app.',
  },
];
---

<BaseLayout
  title="StudentFlow — Your semester, in flow"
  description="StudentFlow: Academic Planner — courses, deadlines, work shifts, and GPA in one calm, living timeline, with a focus timer that keeps you locked in. Free on the App Store."
>
  <!-- Sketch theme showcase uses Shantell Sans (the app's handwriting font) -->
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Shantell+Sans:wght@400;600;700&display=swap"
    rel="stylesheet"
  />

  <!-- ═══════════════ HERO — the pixel ocean ═══════════════ -->
  <section class="hero">
    <div class="hero-ocean" aria-hidden="true"><canvas data-ocean="light"></canvas></div>

    <div class="hero-inner">
      <span class="eyebrow anim-up" style="--d: 0.55s"><span class="dot"></span> Now on the App Store</span>
      <h1>
        <span class="hl"><span style="--d: 0.05s">Your semester,</span></span>
        <span class="hl"><span style="--d: 0.16s" class="grad-text">in flow.</span></span>
      </h1>
      <p class="lede anim-up" style="--d: 0.62s">
        Courses, deadlines, work shifts, and GPA — one calm, living timeline.
        StudentFlow is the academic planner that moves the way your day does.
      </p>
      <div class="hero-cta anim-up" style="--d: 0.7s">
        <a href={APPSTORE} target="_blank" rel="noopener" class="badge-link magnetic" aria-label="Download StudentFlow on the App Store">
          <AppStoreBadge height={54} />
        </a>
        <a href="/app" class="btn btn-ghost btn-lg magnetic">Open the web app →</a>
      </div>
      <div class="hero-note anim-up" style="--d: 0.78s">
        <Fragment set:html={ico.check} />
        Free to download · No account required · Private by design
      </div>

      <div class="hero-stage anim-up" style="--d: 0.5s">
        <div class="stage-tilt" data-tilt>
          <div class="phone phone-left"><div class="phone-screen" data-vec="calendar"></div></div>
          <div class="phone phone-front"><div class="phone-screen" data-vec="home"></div></div>
          <div class="phone phone-right"><div class="phone-screen" data-vec="endless"></div></div>
        </div>
      </div>
    </div>

    <div class="scroll-cue" aria-hidden="true">
      A day in the flow
      <Fragment set:html={ico.chevD} />
    </div>
  </section>

  <!-- ═══════════════ A DAY IN THE FLOW ═══════════════ -->
  <section class="section" id="day">
    <div class="day-head">
      <span class="eyebrow reveal"><span class="dot"></span> One app, the whole day</span>
      <h2 class="section-title reveal" style="--reveal-delay: 0.05s">A day in the flow</h2>
      <p class="section-sub reveal" style="--reveal-delay: 0.1s">
        Scroll through a school day the way StudentFlow carries it — from first coffee to lights out.
      </p>
    </div>

    <!-- 8:02 AM — My Day -->
    <article class="chapter" style="--chapter-accent: var(--accent)">
      <div class="rail" aria-hidden="true">
        <span class="time-chip">8:02 AM</span>
        <svg class="rail-line" viewBox="0 0 26 300" preserveAspectRatio="none">
          <path d="M13 0 C 22 40 4 80 13 120 C 22 160 4 200 13 240 C 19 268 9 286 13 300" />
        </svg>
      </div>
      <div class="chapter-copy reveal">
        <span class="time-chip time-chip-inline">8:02 AM</span>
        <span class="chapter-kicker">My Day</span>
        <h3>Wake up already knowing the plan.</h3>
        <p>
          My Day reads your classes, to-dos and shifts, and lays them onto one calm wave —
          with the gaps made visible, so free time becomes plan-able time.
        </p>
        <ul class="chapter-feats">
          <li>
            <span class="feat-ico"><Fragment set:html={ico.spark} /></span>
            <span><b>Task Intelligence.</b> Overdue, due today, and up next — triaged for you before you ask.</span>
          </li>
          <li>
            <span class="feat-ico"><Fragment set:html={ico.gap} /></span>
            <span><b>Gap chips.</b> "3h 45m free" between stops — tap Plan and spend it on purpose.</span>
          </li>
          <li>
            <span class="feat-ico"><Fragment set:html={ico.chart} /></span>
            <span><b>Focus Insight.</b> A 7-day chart of your focus time, streak, and average session.</span>
          </li>
        </ul>
      </div>
      <div class="chapter-visual reveal reveal-scale">
        <div class="phone" data-chapter-phone><div class="phone-screen" data-vec="home"></div></div>
      </div>
    </article>

    <!-- 12:30 PM — Calendar 2.0 -->
    <article class="chapter flip" style="--chapter-accent: var(--accent-deep)">
      <div class="rail" aria-hidden="true">
        <span class="time-chip">12:30 PM</span>
        <svg class="rail-line" viewBox="0 0 26 300" preserveAspectRatio="none">
          <path d="M13 0 C 4 40 22 80 13 120 C 4 160 22 200 13 240 C 7 268 17 286 13 300" />
        </svg>
      </div>
      <div class="chapter-copy reveal">
        <span class="time-chip time-chip-inline">12:30 PM</span>
        <span class="chapter-kicker">Calendar 2.0</span>
        <h3>A calendar that runs at true time.</h3>
        <p>
          Flick the week strip open into a month — or flip the whole view into a three-day
          board where events sit at their real hour, and a now-line glides through the day.
        </p>
        <ul class="chapter-feats">
          <li>
            <span class="feat-ico"><Fragment set:html={ico.board} /></span>
            <span><b>True-time 3-day board.</b> Overlapping events lane themselves; live classes fill with progress.</span>
          </li>
          <li>
            <span class="feat-ico"><Fragment set:html={ico.zoom} /></span>
            <span><b>24h zoom.</b> Pull the window to 7a–11p, or keep the whole day on screen.</span>
          </li>
          <li>
            <span class="feat-ico"><Fragment set:html={ico.pillico} /></span>
            <span><b>The summary pill.</b> "4 planned · 2 due · 3h free" — your day, in one glance.</span>
          </li>
        </ul>
      </div>
      <div class="chapter-visual reveal reveal-scale">
        <div class="phone" data-chapter-phone><div class="phone-screen" data-vec="calendar"></div></div>
      </div>
    </article>
  </section>

  <!-- 3:00 PM — FLOW (full-bleed dark band) -->
  <section class="flowband" id="flow">
    <div class="flowband-inner">
      <div class="rail" aria-hidden="true">
        <span class="time-chip">3:00 PM</span>
        <svg class="rail-line" viewBox="0 0 26 300" preserveAspectRatio="none">
          <path d="M13 0 C 22 40 4 80 13 120 C 22 160 4 200 13 240 C 19 268 9 286 13 300" />
        </svg>
      </div>
      <div class="chapter-copy reveal">
        <span class="time-chip time-chip-inline">3:00 PM</span>
        <span class="chapter-kicker">Flow</span>
        <h3>Then — disappear into the work.</h3>
        <p class="fb-lede">
          One tap and the noise drops away. A living gradient orb breathes while the timer
          runs, and the world waits. Three ways in — pick your depth.
        </p>
        <div class="fb-modes">
          <div class="fb-mode" style="--fm-a: #8f90ed; --fm-b: #4c4ebe">
            <span class="fm-tag">Pomodoro</span>
            <span class="fm-ico"><Fragment set:html={ico.clock} /></span>
            <b>Regular</b>
            <span>Pomodoro style — customize your pace, breaks and all.</span>
          </div>
          <div class="fb-mode" style="--fm-a: #71bf9d; --fm-b: #3f9a72">
            <span class="fm-tag">Deep work</span>
            <span class="fm-ico"><Fragment set:html={ico.inf} /></span>
            <b>Endless</b>
            <span>Keep going with gentle reminders. No clock to beat.</span>
          </div>
          <div class="fb-mode" style="--fm-a: #b79ef2; --fm-b: #8a63d9">
            <span class="fm-tag">Curated</span>
            <span class="fm-ico"><Fragment set:html={ico.list} /></span>
            <b>Guided</b>
            <span>Pick specific assignments to work through, one by one.</span>
          </div>
        </div>
        <div class="fb-lock">
          <span class="fl-toggle" aria-hidden="true"></span>
          <span>
            <b>Lock In</b>
            <span>Distraction guard on — leaving early takes a deliberate hold, not a tap.</span>
          </span>
        </div>
      </div>
      <div class="fb-scene reveal reveal-scale" aria-hidden="true">
        <div class="fb-orb"></div>
        <div class="fb-time" data-seconds="2832"><span class="mmss">47:12</span><span class="centi">.00</span></div>
        <div class="fb-status"><i></i> FLOWING</div>
        <div class="fb-medal"><Fragment set:html={ico.award} /> On Fire — a solid 30+ minute flow</div>
      </div>
    </div>
  </section>

  <!-- 9:15 PM — Courses & GPA -->
  <section class="section">
    <article class="chapter" style="--chapter-accent: var(--coral)">
      <div class="rail" aria-hidden="true">
        <span class="time-chip">9:15 PM</span>
        <svg class="rail-line" viewBox="0 0 26 300" preserveAspectRatio="none">
          <path d="M13 0 C 4 40 22 80 13 120 C 4 160 22 200 13 240 C 7 268 17 286 13 300" />
        </svg>
      </div>
      <div class="chapter-copy reveal">
        <span class="time-chip time-chip-inline">9:15 PM</span>
        <span class="chapter-kicker">Courses &amp; GPA</span>
        <h3>End the day knowing exactly where you stand.</h3>
        <p>
          The semester view keeps score quietly: term progress with every deadline pinned
          to the line, pending against done, and your GPA — course by course.
        </p>
        <ul class="chapter-feats">
          <li>
            <span class="feat-ico"><Fragment set:html={ico.ticks} /></span>
            <span><b>The term line.</b> Week 4 of 15, deadline ticks ahead, a breathing "now" marker.</span>
          </li>
          <li>
            <span class="feat-ico"><Fragment set:html={ico.grade} /></span>
            <span><b>GPA, always current.</b> Grade chips per course; a cumulative number that never surprises you.</span>
          </li>
          <li>
            <span class="feat-ico"><Fragment set:html={ico.camera} /></span>
            <span><b>Work shifts too.</b> Snap a photo of the posted schedule — it lands on your calendar, read on-device.</span>
          </li>
        </ul>
      </div>
      <div class="chapter-visual reveal reveal-scale">
        <div class="phone" data-chapter-phone><div class="phone-screen" data-vec="courses"></div></div>
      </div>
    </article>
  </section>

  <!-- ═══════════════ Bento — the quiet superpowers ═══════════════ -->
  <section class="section" id="details">
    <div class="day-head">
      <span class="eyebrow reveal"><span class="dot"></span> The quiet superpowers</span>
      <h2 class="section-title reveal" style="--reveal-delay: 0.05s">Small details, compounding daily</h2>
    </div>
    <div class="bento">
      <article class="tile tile-3 reveal reveal-scale">
        <div class="scan-stage" aria-hidden="true">
          <span class="scan-photo"><i></i><i></i><i></i><i></i></span>
          <span class="scan-arrow"><Fragment set:html={ico.arrow} /></span>
          <span class="scan-rows">
            <span class="scan-row"><i></i> Mon <span class="sr-t">4:00–9:00p</span></span>
            <span class="scan-row"><i></i> Wed <span class="sr-t">5:30–10:00p</span></span>
            <span class="scan-row"><i></i> Sat <span class="sr-t">11:00a–4:00p</span></span>
          </span>
        </div>
        <h3>Your work schedule, scanned</h3>
        <p>
          Snap a photo of the posted schedule. StudentFlow reads it on-device and drops your
          shifts straight onto the timeline — next to classes, where they belong.
        </p>
      </article>

      <article class="tile tile-3 reveal reveal-scale" style="--reveal-delay: 0.07s">
        <div class="priv-stage" aria-hidden="true">
          <span class="priv-ring"><Fragment set:html={ico.shield} /></span>
        </div>
        <h3>Private by design</h3>
        <p>
          No account required. Works offline. Your courses and grades stay on your iPhone —
          never sold, never mined. The web app only uses your Apple&nbsp;ID to sign you in.
        </p>
      </article>

      <article class="tile tile-2 stat-tile reveal reveal-scale">
        <div class="gpa-ring" aria-hidden="true">
          <svg viewBox="0 0 108 108">
            <defs>
              <linearGradient id="gpaGrad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#8f90ed" />
                <stop offset="1" stop-color="#4c4ebe" />
              </linearGradient>
            </defs>
            <circle class="gr-bg" cx="54" cy="54" r="46" />
            <circle class="gr-fg" cx="54" cy="54" r="46" style="--gr-off: 66" />
          </svg>
          <span class="gpa-num" data-count="3.85" data-decimals="2">0.00</span>
        </div>
        <h3>GPA, tracked live</h3>
        <p>Course by course, term by term.</p>
      </article>

      <article class="tile tile-2 stat-tile reveal reveal-scale" style="--reveal-delay: 0.07s">
        <div class="medal-stage" aria-hidden="true">
          <span class="medallion"><Fragment set:html={ico.medal} /></span>
        </div>
        <h3>Finish with a medal</h3>
        <p>Every session ends in a summary — Locked&nbsp;In → On&nbsp;Fire → In&nbsp;the&nbsp;Zone → Legendary.</p>
      </article>

      <article class="tile tile-2 stat-tile reveal reveal-scale" style="--reveal-delay: 0.14s">
        <span class="pill">Soon</span>
        <div class="medal-stage" aria-hidden="true">
          <span class="streak-flame" style="color: var(--accent); background: rgba(89,91,205,0.12)"><Fragment set:html={ico.sync} /></span>
        </div>
        <h3>Canvas sync</h3>
        <p>Courses and assignments, pulled in automatically.</p>
      </article>
    </div>
  </section>

  <!-- ═══════════════ Themes (Living Flow vs Sketch) ═══════════════ -->
  <section class="section" id="themes">
    <div class="day-head">
      <span class="eyebrow reveal"><span class="dot"></span> Two themes, one flow</span>
      <h2 class="section-title reveal" style="--reveal-delay: 0.05s">Make it yours</h2>
      <p class="section-sub reveal" style="--reveal-delay: 0.1s">
        Study in calm, glassy <strong>Living Flow</strong> — or cozy, hand-drawn <strong>Sketch</strong>.
        Switch anytime in the app. Drag to compare.
      </p>
    </div>

    <div class="theme-compare reveal" style="--reveal-delay: 0.05s" data-theme-compare>
      <div class="phone phone-compare">
        <div class="phone-screen">
          <div class="tc-pane tc-flow theme-flow" data-theme-home>
            <span class="tc-tag flow">Living Flow</span>
          </div>
          <div class="tc-pane tc-sketch theme-sketch" data-theme-home>
            <span class="tc-tag sketch">Sketch</span>
          </div>
          <div
            class="tc-handle"
            data-tc-handle
            role="slider"
            tabindex="0"
            aria-label="Drag to compare the Living Flow and Sketch themes"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="50"
          >
            <span class="tc-grip">
              <svg width="9" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
              <svg width="9" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
            </span>
          </div>
        </div>
      </div>
      <p class="tc-hint">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 7 3 12l5 5M16 7l5 5-5 5M3 12h18" /></svg>
        Drag to compare the two themes
      </p>
    </div>
  </section>

  <!-- ═══════════════ Web app ═══════════════ -->
  <section class="section" id="webapp">
    <div class="web-band reveal reveal-scale">
      <div class="web-copy">
        <span class="eyebrow"><span class="dot"></span> Works with the app</span>
