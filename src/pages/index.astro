      <span class="vsx-allday"><i></i>Independence Day (observed)</span>
      <div class="vsx-tl cal">
        ${vsxWave}
        ${vsxJob('12:30a', '3:00a', 'Cafe', '12:30a – 3a · Opening', '')}
