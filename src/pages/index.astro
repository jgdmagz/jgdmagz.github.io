        <div class="vsx-row">${vsxTime('1:00p', '2:15p')}${vsxDot('live')}
          <div class="vsx-card"><span class="bar" style="background:var(--coral)"></span><b>Calculus II</b><span class="sub">1:00p – 2:15p · 75 min</span></div>
