---
import BaseLayout from '../layouts/BaseLayout.astro';
import FlowMark from '../components/FlowMark.astro';
---

<BaseLayout
  title="Sign in · StudentFlow"
  description="Sign in to StudentFlow with your Apple ID — the same account works in the app and on the web."
>
  <section class="auth">
    <div class="auth-card">
      <!-- Living pixel waves — the brand's flowing wave bands on an 11px grid -->
      <div class="pixel-hero" aria-hidden="true">
        <canvas id="pixel-wave"></canvas>
        <div class="pixel-fade"></div>
      </div>

      <div class="auth-body">
        <div class="auth-mark"><FlowMark size={64} gradId="fgAuth" /></div>

        <div id="signed-out">
          <h1>Welcome to <span class="wordmark">StudentFlow</span></h1>
          <p class="auth-sub">Sign in with your Apple ID — the same account works in the app and here.</p>

          <button id="apple" class="apple-btn" type="button">
            <svg viewBox="0 0 384 512" width="17" height="17" fill="currentColor" aria-hidden="true">
              <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C71.5 141.2 16 184.6 16 273.5c0 26.6 4.9 54.1 14.6 82.4 13 37.1 59.9 128.1 108.8 126.6 25.6-.6 43.7-18.2 77-18.2 32.3 0 49 18.2 77.4 18.2 49.3-.7 91.7-83.4 104.1-120.6-66.2-31.2-66.2-91.4-66.2-93.2zM254.8 90.9c30.8-36.5 28-69.7 27.1-81.6-27.2 1.6-58.7 18.5-76.6 39.4-19.7 22.6-31.3 50.5-28.8 81.4 29.4 2.3 56.2-12.8 78.3-39.2z"></path>
            </svg>
            Sign in with Apple
          </button>

          <a class="auth-demo" href="/app/preview">Just looking? Try the live demo →</a>

          <p class="auth-fine">
            We only use your Apple ID to sign you in — nothing else. See our
            <a href="/privacy">privacy policy</a>.
          </p>
        </div>

        <div id="signed-in" hidden>
          <h1>You're in 🎉</h1>
          <p class="auth-sub">Signed in as <strong id="who"></strong></p>
          <a href="/app" class="apple-btn" role="button">Open the web app</a>
          <a href="/app/profile" class="btn btn-ghost" role="button" style="margin-top:0.7rem">Your profile</a>
          <button id="signout" class="btn btn-ghost" type="button" style="margin-top:0.7rem">Sign out</button>
        </div>

        <p id="status" class="auth-status" hidden></p>
      </div>
    </div>
  </section>

  <!-- Pixel-wave hero — vanilla port of the web app's AuthGate PixelOcean:
       FBM-bent traveling wave bands over an 11px cell grid, brand color ramp,
       shimmer on the crests. ~25fps, paused when hidden, static frame under
       prefers-reduced-motion. Keep the math in sync with AuthGate.tsx. -->
  <script is:inline>
    (() => {
      const cv = document.getElementById('pixel-wave');
      if (!cv) return;
      const ctx = cv.getContext('2d');
      if (!ctx) return;

      const CELL = 11;
      const GAP = 1.5;

      const hash2 = (x, y) => {
        const h = Math.sin(x * 127.1 + y * 311.7) * 43758.5453123;
        return h - Math.floor(h);
      };
      const smooth = (t) => t * t * (3 - 2 * t);
      const noise = (x, y) => {
        const xi = Math.floor(x), yi = Math.floor(y);
        const xf = x - xi, yf = y - yi;
        const a = hash2(xi, yi), b = hash2(xi + 1, yi);
        const c = hash2(xi, yi + 1), d = hash2(xi + 1, yi + 1);
        const u = smooth(xf), v = smooth(yf);
        return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
      };
      const fbm = (x, y) => {
        let val = 0, amp = 0.5, fx = x, fy = y;
        for (let i = 0; i < 4; i++) {
          val += amp * noise(fx, fy);
          fx *= 2.02; fy *= 1.98; amp *= 0.5;
        }
        return val;
      };

      // canvas trough → washes → periwinkle → indigo crest
      const RAMP = [
        [0.0, [244, 244, 250]],
        [0.3, [230, 231, 246]],
        [0.52, [199, 201, 242]],
        [0.7, [158, 159, 234]],
        [0.86, [107, 109, 214]],
        [1.0, [63, 63, 180]],
      ];
      const ramp = (t) => {
        const v = Math.min(1, Math.max(0, t));
        for (let i = 1; i < RAMP.length; i++) {
          if (v <= RAMP[i][0]) {
            const t0 = RAMP[i - 1][0], c0 = RAMP[i - 1][1];
            const t1 = RAMP[i][0], c1 = RAMP[i][1];
            const k = (v - t0) / (t1 - t0);
            return [
              c0[0] + (c1[0] - c0[0]) * k,
              c0[1] + (c1[1] - c0[1]) * k,
              c0[2] + (c1[2] - c0[2]) * k,
            ];
          }
        }
        return RAMP[RAMP.length - 1][1];
      };

      const draw = (t) => {
        const wrap = cv.parentElement;
        if (!wrap) return;
        const dpr = Math.min(2, window.devicePixelRatio || 1);
        const W = wrap.clientWidth, H = wrap.clientHeight;
        if (cv.width !== Math.round(W * dpr) || cv.height !== Math.round(H * dpr)) {
          cv.width = Math.round(W * dpr);
          cv.height = Math.round(H * dpr);
        }
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.fillStyle = 'rgb(226,228,240)';
        ctx.fillRect(0, 0, W, H);

        const cols = Math.ceil(W / CELL), rows = Math.ceil(H / CELL);
        for (let gy = 0; gy < rows; gy++) {
          for (let gx = 0; gx < cols; gx++) {
            const nx = gx * 0.09, ny = gy * 0.11;
            // Traveling sines + a soft FBM current bend each wave band.
            const bend =
              0.5 * Math.sin(nx * 1.35 + t * 0.85) +
              0.28 * Math.sin(nx * 2.5 - t * 0.55) +
              0.9 * (fbm(nx * 0.55 + t * 0.06, ny * 0.5 - t * 0.04) - 0.5);
            let h = 0.5 + 0.5 * Math.sin((ny + bend) * 3.4 - t * 0.7);
            h = Math.pow(Math.min(1, Math.max(0, h)), 2.1);
            // Shimmer riding the crests.
            if (h > 0.62) {
              const sparkle = noise(gx * 3.1 + t * 2.2, gy * 3.3 - t * 1.7);
              h = Math.min(1, h + (sparkle > 0.86 ? 0.5 : 0) * (h - 0.62));
            }
            const c = ramp(h);
            ctx.fillStyle = 'rgb(' + (c[0] | 0) + ',' + (c[1] | 0) + ',' + (c[2] | 0) + ')';
            ctx.beginPath();
            ctx.roundRect(gx * CELL + GAP / 2, gy * CELL + GAP / 2, CELL - GAP, CELL - GAP, 2);
            ctx.fill();
          }
        }
      };

      // Redraw on layout/resize — in dev the styles land after this script
      // runs, so the first draw can happen while the hero still has no width.
      let lastT = 4.2;
      new ResizeObserver(() => draw(lastT)).observe(cv.parentElement);

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        draw(lastT);
        return;
      }
      let last = 0;
      const tick = (ms) => {
        requestAnimationFrame(tick);
        if (document.hidden || ms - last < 40) return;
        last = ms;
        lastT = ms / 1000;
        draw(lastT);
      };
      requestAnimationFrame(tick);
      draw(lastT);
    })();
  </script>

  <!--
    is:inline keeps Astro from bundling this so the browser loads supabase-js
    from the CDN (no npm install needed). The anon key is public by design —
    real access is gated by Supabase Row-Level-Security, not this key.
  -->
  <script is:inline type="module">
    import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

    const supabase = createClient(
      'https://jatxquhxqxrnjbmjoqna.supabase.co',
      'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImphdHhxdWh4cXhybmpibWpvcW5hIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA2MTAyMTksImV4cCI6MjA5NjE4NjIxOX0.cx2qMXzadunoJtq82FT-UYAstFZ_ym3FAnIpHkzgzdM'
    );

    const $ = (id) => document.getElementById(id);

    async function render() {
      const { data: { session } } = await supabase.auth.getSession();
      const signedIn = !!session;
      $('signed-out').hidden = signedIn;
      $('signed-in').hidden = !signedIn;
      if (signedIn) $('who').textContent = session.user.email ?? session.user.id;
    }

    $('apple').addEventListener('click', async () => {
      $('status').hidden = true;
      // Land straight in the web app after the Apple round-trip.
      const { error } = await supabase.auth.signInWithOAuth({
        provider: 'apple',
        options: { redirectTo: window.location.origin + '/app' },
      });
      if (error) { $('status').hidden = false; $('status').textContent = error.message; }
    });

    $('signout').addEventListener('click', async () => { await supabase.auth.signOut(); render(); });

    supabase.auth.onAuthStateChange(() => render());
    render();
  </script>
</BaseLayout>

<style>
  .auth {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 150px);
    padding: 2.5rem 1rem;
  }
  .auth-card {
    position: relative;
    width: 100%;
    max-width: 420px;
    overflow: hidden;
    border-radius: 32px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.72), #fbfbfe 40%);
    border: 1px solid rgba(255, 255, 255, 0.75);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.35),
      0 30px 70px -28px rgba(63, 63, 180, 0.35),
      0 8px 24px rgba(63, 63, 180, 0.12);
    animation: fadeUp 0.7s ease both;
  }
  .pixel-hero {
    position: relative;
    height: 230px;
  }
  .pixel-hero canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .pixel-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 48%, rgba(251, 251, 254, 0.55) 80%, #fbfbfe 100%);
    pointer-events: none;
  }
  .auth-body {
    position: relative;
    text-align: center;
    padding: 0 2rem 1.9rem;
  }
  .auth-mark {
    display: flex;
    justify-content: center;
    margin-top: -32px;
    margin-bottom: 0.9rem;
  }
  .auth-body h1 {
    font-size: 1.7rem;
    letter-spacing: -0.02em;
    font-weight: 800;
    margin: 0 0 0.5rem;
    color: var(--ink);
  }
  .wordmark {
    background: linear-gradient(90deg, #8f90ed, #595bcd, #4c4ebe);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .auth-sub {
    color: var(--ink-mid);
    margin: 0 0 1.7rem;
    font-size: 0.98rem;
    line-height: 1.55;
  }
  .apple-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    width: 100%;
    border: none;
    cursor: pointer;
    background: #000;
    color: #fff;
    font-family: var(--font);
    font-weight: 600;
    font-size: 1.05rem;
    padding: 0.9rem 1.3rem;
    border-radius: 999px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .apple-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 28px -12px rgba(0, 0, 0, 0.4);
  }
  .apple-btn svg {
    margin-top: -2px;
  }
  .auth-demo {
    display: inline-block;
    margin-top: 0.95rem;
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--accent-deep);
    text-decoration: none;
  }
  .auth-demo:hover {
    text-decoration: underline;
  }
  .auth-fine {
    color: var(--ink-subtle);
    font-size: 0.82rem;
    margin: 1.1rem 0 0;
  }
  .auth-status {
    color: var(--coral);
    font-size: 0.9rem;
    margin-top: 1.1rem;
  }
</style>
