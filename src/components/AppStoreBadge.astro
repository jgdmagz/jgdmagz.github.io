---
// "Download on the App Store" badge — drawn inline (official-style black
// lozenge + Apple glyph) so it needs no external asset and inherits crisp
// rendering at any DPI. `height` scales the whole badge proportionally.
const { height = 54 } = Astro.props;
const width = Math.round(height * (170 / 54));
---
<svg
  width={width}
  height={height}
  viewBox="0 0 170 54"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Download on the App Store"
>
  <rect x="0.75" y="0.75" width="168.5" height="52.5" rx="11" fill="#000" stroke="#a6a6a6" stroke-width="1.5" />
  <!-- Apple glyph — StudentFlow brand indigo -->
  <path
    fill="#595BCD"
    d="M31.2 27.6c-.03-3.4 2.78-5.03 2.9-5.11-1.58-2.31-4.04-2.63-4.91-2.66-2.09-.21-4.08 1.23-5.14 1.23-1.06 0-2.7-1.2-4.44-1.17-2.28.03-4.39 1.33-5.56 3.37-2.37 4.12-.6 10.22 1.71 13.57 1.13 1.64 2.48 3.48 4.25 3.41 1.71-.07 2.35-1.1 4.42-1.1 2.06 0 2.64 1.1 4.44 1.07 1.84-.03 3-1.67 4.13-3.32 1.3-1.91 1.83-3.75 1.86-3.85-.04-.02-3.57-1.37-3.6-5.44Zm-3.38-9.98c.94-1.14 1.58-2.73 1.4-4.31-1.36.06-3 .9-3.97 2.04-.87 1-1.63 2.62-1.43 4.17 1.52.12 3.06-.77 4-1.9Z"
  />
  <!-- "Download on the" -->
  <text x="44" y="21.5" fill="#fff" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="9.5" font-weight="500" letter-spacing="0.06">Download on the</text>
  <!-- "App Store" -->
  <text x="43" y="41" fill="#fff" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="19" font-weight="650" letter-spacing="-0.2">App Store</text>
</svg>
